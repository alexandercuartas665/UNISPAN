@page "/ViewCustomers"
@using Newtonsoft.Json
@using adesoft.adepos.webview.Data
@using adesoft.adepos.webview.Data.DTO
@using adesoft.adepos.webview.Data.Model

@inject DialogService dialogService
@inject LogisticsService logisticsService
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

@code {
    // Modelo para el formulario de CREACIÓN de un nuevo cliente
    private DTOLogisticMasterData newCustomer;

    // Modelo para el formulario de EDICIÓN, será nulo hasta que se seleccione un cliente
    private DTOLogisticMasterData editCustomer;

    // Lista de clientes para la grilla
    public List<DTOLogisticMasterData> customers;

    protected override async Task OnInitializedAsync()
    {
        InitializeNewCustomer();
        customers = await logisticsService.GetCustomers();
    }

    // Prepara el objeto para un nuevo cliente
    private void InitializeNewCustomer()
    {
        newCustomer = new DTOLogisticMasterData { Type = "CLIENTE" };
    }

    //MÉTODOS PARA CREACIÓN
    private async Task CreateCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(newCustomer.IdentificationNum) || string.IsNullOrWhiteSpace(newCustomer.Description))
        {
            ShowNotification(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = "ERROR", Detail = "El NIT y el Nombre son obligatorios.", Duration = 4000 });
            return;
        }

        await logisticsService.CreateOrUpdateCustomer(newCustomer);
        ShowNotification(new NotificationMessage() { Severity = NotificationSeverity.Success, Summary = "Éxito", Detail = "Cliente creado correctamente.", Duration = 4000 });

        InitializeNewCustomer(); // Limpia el formulario de creación
        customers = await logisticsService.GetCustomers(); // Refresca la grilla
        StateHasChanged();
    }

    //MÉTODOS PARA EDICIÓN
    private void SelectCustomerToEdit(DTOLogisticMasterData customerToEdit)
    {
        // Clona el objeto para evitar que cambios accidentales en el formulario afecten la grilla antes de guardar
        editCustomer = new DTOLogisticMasterData
        {
            Id = customerToEdit.Id,
            IdentificationNum = customerToEdit.IdentificationNum,
            Description = customerToEdit.Description,
            Type = customerToEdit.Type
        };
    }

    private async Task UpdateCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(editCustomer.Description))
        {
            ShowNotification(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = "ERROR", Detail = "El Nombre es obligatorio.", Duration = 4000 });
            return;
        }

        await logisticsService.CreateOrUpdateCustomer(editCustomer);
        ShowNotification(new NotificationMessage() { Severity = NotificationSeverity.Success, Summary = "Éxito", Detail = "Cliente actualizado correctamente.", Duration = 4000 });

        editCustomer = null; // Oculta el formulario de edición
        customers = await logisticsService.GetCustomers(); // Refresca la grilla
    }

    private void CancelEdit()
    {
        editCustomer = null; // Simplemente oculta el formulario de edición
    }

    private void ShowNotification(NotificationMessage message)
    {
        notificationService.Notify(message);
    }
}

<div class="card">
    <div class="card-header">
        GESTIÓN DE CLIENTES
        <div class="float-right">
            <a href="javascript:void(0);" @onclick="@(args => dialogService.Close(true))">Cerrar</a>
        </div>
    </div>
    <div class="card-body">

        <RadzenFieldset Text="Crear Nuevo Cliente">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="newId">Número de identificación (NIT)</label>
                    <RadzenTextBox Name="newId" @bind-Value="newCustomer.IdentificationNum" class="form-control" />
                </div>
                <div class="form-group col-md-5">
                    <label for="newName">Nombre del Cliente</label>
                    <RadzenTextBox Name="newName" @bind-Value="newCustomer.Description" class="form-control" />
                </div>
                <div class="form-group col-md-3" style="align-self: flex-end;">
                    <button class="btn btn-success" @onclick="CreateCustomerAsync">
                        <span class="oi oi-plus" aria-hidden="true"></span> Crear Cliente
                    </button>
                </div>
            </div>
        </RadzenFieldset>

        @if (editCustomer != null)
        {
            <RadzenFieldset Text="Editar Cliente" class="mt-4">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="editId">Número de identificación (NIT)</label>
                        <RadzenTextBox Name="editId" @bind-Value="editCustomer.IdentificationNum" class="form-control" ReadOnly="true" />
                    </div>
                    <div class="form-group col-md-5">
                        <label for="editName">Nombre del Cliente</label>
                        <RadzenTextBox Name="editName" @bind-Value="editCustomer.Description" class="form-control" />
                    </div>
                    <div class="form-group col-md-3" style="align-self: flex-end;">
                        <button class="btn btn-primary" @onclick="UpdateCustomerAsync">
                            <span class="oi oi-check" aria-hidden="true"></span> Guardar Cambios
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelEdit">
                            <span class="oi oi-x" aria-hidden="true"></span> Cancelar
                        </button>
                    </div>
                </div>
            </RadzenFieldset>
        }

        <div class="form-row pt-4">
            <div class="col-md-12">
                <h5>Clientes Existentes</h5>
                <RadzenGrid AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowPaging="true" PageSize="10" AllowSorting="true" Data="@customers" TItem="DTOLogisticMasterData" ColumnWidth="200px" EmptyText="No hay clientes para mostrar.">
                    <Columns>
                        <RadzenGridColumn TItem="DTOLogisticMasterData" Property="IdentificationNum" Title="Número de identificación" Width="200px" />
                        <RadzenGridColumn TItem="DTOLogisticMasterData" Property="Description" Title="Nombre" />
                        <RadzenGridColumn TItem="DTOLogisticMasterData" Width="50px" TextAlign="TextAlign.Center">
                            <HeaderTemplate>
                                <div style="text-align:center; width:100%;">Editar</div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <button class="btn btn-info btn-sm" @onclick="@(args => SelectCustomerToEdit(data))">
                                    <span class="oi oi-pencil" aria-hidden="true"></span> Editar
                                </button>
                            </Template>
                        </RadzenGridColumn>
                    </Columns>
                </RadzenGrid>
            </div>
        </div>

    </div>
</div>