@page "/viewobras"
@using adesoft.adepos.webview.Data
@using adesoft.adepos.webview.Data.DTO
@using adesoft.adepos.webview.Data.DTO.PL
@inject DialogService dialogService
@inject LogisticsService logisticsService
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

<div class="card">
    <div class="card-header">
        <span>ADMINISTRACIÓN DE OBRAS</span>
        <div class="float-right">
            <a href="javascript:void(0);" @onclick="@(args => dialogService.Close(true))">Cerrar</a>
        </div>
    </div>
    <div class="card-body">

        <RadzenFieldset Text="Crear Nueva Obra">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Cliente<b class="text-danger">*</b></label>
                    <RadzenDropDown TValue="int" @bind-Value="newObra.ClienteId" Data="@listaDeClientes" TextProperty="Description" ValueProperty="Id"
                                    AllowFiltering="true" Placeholder="Seleccione un cliente..." class="form-control"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                </div>
                <div class="form-group col-md-6">
                    <label>Nombre de la Obra<b class="text-danger">*</b></label>
                    <RadzenTextBox @bind-Value="newObra.Nombre" class="form-control" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Ciudad</label>
                    <RadzenDropDown TValue="int?" @bind-Value="newObra.CiudadId" Data="@listaDeCiudades" TextProperty="Description" ValueProperty="Id"
                                    AllowFiltering="true" AllowClear="true" Placeholder="Seleccione una ciudad..." class="form-control"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" />
                </div>
                <div class="form-group col-md-6">
                    <label>Comercial</label>
                    <RadzenDropDown TValue="int?" @bind-Value="newObra.ComercialId" Data="@listaDeComerciales" TextProperty="Description" ValueProperty="Id"
                                    AllowFiltering="true" AllowClear="true" Placeholder="Seleccione un comercial..." class="form-control"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label>Correos (separados por " ; ")</label>
                    <RadzenTextArea @bind-Value="newObra.Correos" class="form-control" Rows="2" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <RadzenButton Icon="add" Style="background-color: #007bff; border-color: #007bff; color: white;" Text="Crear Obra" Click="CreateObraAsync" />
                </div>
            </div>
        </RadzenFieldset>

        @if (editObra != null)
        {
            <RadzenFieldset Text="Editar Obra" class="mt-4">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Cliente<b class="text-danger">*</b></label>
                        <RadzenDropDown TValue="int" @bind-Value="editObra.ClienteId" Data="@listaDeClientes" TextProperty="Description" ValueProperty="Id"
                                        AllowFiltering="true" Placeholder="Seleccione un cliente..." class="form-control"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Nombre de la Obra<b class="text-danger">*</b></label>
                        <RadzenTextBox @bind-Value="editObra.Nombre" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Ciudad</label>
                        <RadzenDropDown TValue="int?" @bind-Value="editObra.CiudadId" Data="@listaDeCiudades" TextProperty="Description" ValueProperty="Id"
                                        AllowFiltering="true" AllowClear="true" Placeholder="Seleccione una ciudad..." class="form-control"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Comercial</label>
                        <RadzenDropDown TValue="int?" @bind-Value="editObra.ComercialId" Data="@listaDeComerciales" TextProperty="Description" ValueProperty="Id"
                                        AllowFiltering="true" AllowClear="true" Placeholder="Seleccione un comercial..." class="form-control"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label>Correos (separados por " ; ")</label>
                        <RadzenTextArea @bind-Value="editObra.Correos" class="form-control" Rows="2" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Estado</label>
                        <RadzenDropDown TValue="bool" @bind-Value="editObra.Activo" Data="@(new[] { new { Text = "Activo", Value = true }, new { Text = "Inactivo", Value = false } })"
                                        TextProperty="Text" ValueProperty="Value" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-12">
                        <RadzenButton Icon="save" Style="background-color: #007bff; border-color: #007bff; color: white;" Text="Guardar Cambios" Click="UpdateObraAsync" />
                        <RadzenButton Icon="cancel" Style="background-color: #dc3545; border-color: #dc3545; color: white;" Text="Cancelar" Class="ml-2" Click="CancelEdit" />
                    </div>
                </div>
            </RadzenFieldset>
        }

        <hr />

        <h5>Listado de Obras</h5>
        <div class="form-row mb-3">
            <div class="form-group col-md-6">
                <RadzenTextBox @oninput="OnFiltroClienteChange" Placeholder="Filtrar por Nombre de Cliente..." class="form-control" />
            </div>
            <div class="form-group col-md-6">
                <RadzenTextBox @oninput="OnFiltroObraChange" Placeholder="Filtrar por Nombre de Obra..." class="form-control" />
            </div>
        </div>
        <RadzenDataGrid @ref="gridObras" TItem="DTOObras" Data="@obrasFiltradas" AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="10" class="mt-3" EmptyText="No hay obras para mostrar.">
            <Columns>
                <RadzenDataGridColumn TItem="DTOObras" Property="NombreCliente" Title="Cliente" Width="200px" />
                <RadzenDataGridColumn TItem="DTOObras" Property="Nombre" Title="Nombre Obra" Width="200px" />
                <RadzenDataGridColumn TItem="DTOObras" Property="NombreCiudad" Title="Ciudad" Width="130px" />
                <RadzenDataGridColumn TItem="DTOObras" Property="NombreComercial" Title="Comercial" Width="130px" />
                <RadzenDataGridColumn TItem="DTOObras" Property="Correos" Title="Correos" />
                <RadzenDataGridColumn TItem="DTOObras" Title="Acciones" Width="120px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <div style="text-align:center; width:100%;">Editar/Eliminar</div>
                    </HeaderTemplate>
                    <Template Context="data">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => SelectObraToEdit(data))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Class="ml-1" Click="@(async () => await DeleteRow(data))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

    </div>
</div>

@code {
    // Modelo para el formulario de CREACIÓN
    private DTOObras newObra;
    // Modelo para el formulario de EDICIÓN
    private DTOObras editObra;

    // Listas de datos
    private List<DTOObras> listaDeObras;
    private List<DTOLogisticMasterData> listaDeClientes;
    private List<DTOLogisticMasterData> listaDeCiudades;
    private List<DTOLogisticMasterData> listaDeComerciales;

    private RadzenDataGrid<DTOObras> gridObras;

    // Filtros para la grilla
    private string filtroNombreCliente = "";
    private string filtroNombreObra = "";

    // Propiedad computada para filtrar la grilla en tiempo real
    private IEnumerable<DTOObras> obrasFiltradas =>
        listaDeObras?.Where(o =>
            (string.IsNullOrWhiteSpace(filtroNombreCliente) || o.NombreCliente?.Contains(filtroNombreCliente, StringComparison.OrdinalIgnoreCase) == true) &&
            (string.IsNullOrWhiteSpace(filtroNombreObra) || o.Nombre?.Contains(filtroNombreObra, StringComparison.OrdinalIgnoreCase) == true)
        ) ?? Enumerable.Empty<DTOObras>();

    private void OnFiltroClienteChange(ChangeEventArgs args) => filtroNombreCliente = args.Value.ToString();
    private void OnFiltroObraChange(ChangeEventArgs args) => filtroNombreObra = args.Value.ToString();

    protected override async Task OnInitializedAsync()
    {
        InitializeNewObra();
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        // Carga todos los datos en paralelo para mayor eficiencia
        var obrasTask = logisticsService.GetAllObras();
        var clientesTask = logisticsService.GetCustomers();
        var ciudadesTask = logisticsService.GetLogisticMasterData("CIUDAD");
        var comercialesTask = logisticsService.GetLogisticMasterData("COMERCIAL");

        await Task.WhenAll(obrasTask, clientesTask, ciudadesTask, comercialesTask);

        listaDeObras = obrasTask.Result ?? new List<DTOObras>();
        listaDeClientes = clientesTask.Result;
        listaDeCiudades = ciudadesTask.Result;
        listaDeComerciales = comercialesTask.Result;
    }

    // Prepara el objeto para una nueva obra
    private void InitializeNewObra()
    {
        newObra = new DTOObras { Activo = true };
    }

    // --- MÉTODOS PARA CREACIÓN ---
    private async Task CreateObraAsync()
    {
        if (newObra.ClienteId == 0 || string.IsNullOrWhiteSpace(newObra.Nombre))
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", "Debe seleccionar un cliente y especificar un nombre para la obra.");
            return;
        }

        await logisticsService.CreateOrUpdateObra(newObra);
        notificationService.Notify(NotificationSeverity.Success, "Éxito", "Obra creada correctamente.");

        InitializeNewObra(); // Limpia el formulario
        await LoadInitialData(); // Recarga la grilla
        StateHasChanged();
    }

    // --- MÉTODOS PARA EDICIÓN ---
    private void SelectObraToEdit(DTOObras obra)
    {
        // Clona el objeto para la edición
        editObra = new DTOObras
        {
            Id = obra.Id,
            Nombre = obra.Nombre,
            ClienteId = obra.ClienteId,
            Correos = obra.Correos,
            Activo = obra.Activo,
            CiudadId = obra.CiudadId,
            ComercialId = obra.ComercialId
        };
    }

    private async Task UpdateObraAsync()
    {
        if (editObra.ClienteId == 0 || string.IsNullOrWhiteSpace(editObra.Nombre))
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", "Debe seleccionar un cliente y especificar un nombre para la obra.");
            return;
        }

        await logisticsService.CreateOrUpdateObra(editObra);
        notificationService.Notify(NotificationSeverity.Success, "Éxito", "Obra actualizada correctamente.");

        editObra = null; // Oculta el formulario de edición
        await LoadInitialData(); // Recarga la grilla
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editObra = null; // Oculta el formulario de edición
    }

    // --- MÉTODO PARA ELIMINAR ---
    private async Task DeleteRow(DTOObras obra)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro? Esta acción desactivará la obra '{obra.Nombre}'."))
        {
            var result = await logisticsService.DeleteObra(obra.Id);
            if (result)
            {
                notificationService.Notify(NotificationSeverity.Success, "Éxito", "Obra desactivada.");
                await LoadInitialData();
            }
            else
            {
                notificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo desactivar la obra.");
            }
            StateHasChanged();
        }
    }
}