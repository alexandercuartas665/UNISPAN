@page "/viewobras"
@using adesoft.adepos.webview.Data
@using adesoft.adepos.webview.Data.DTO.PL
@inject DialogService dialogService
@inject LogisticsService logisticsService
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

<div class="card">
    <div class="card-header">
        <span>ADMINISTRACIÓN DE OBRAS</span>
        <div class="float-right">
            <a href="javascript:void(0);" @onclick="@(args => dialogService.Close(false))">Cerrar</a>
        </div>
    </div>
    <div class="card-body">
        <RadzenFieldset Text="Detalle de la Obra">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Cliente<b class="text-danger">*</b></label>
                    <RadzenDropDown @bind-Value="model.ClienteId" Data="@listaDeClientes" TextProperty="Description" ValueProperty="Id"
                                    AllowFiltering="true" Placeholder="Seleccione un cliente..." class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Nombre de la Obra<b class="text-danger">*</b></label>
                    <RadzenTextBox @bind-Value="model.Nombre" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Estado</label>
                    <RadzenDropDown @bind-Value="model.Activo" Data="@(new[] { new { Text = "Activo", Value = true }, new { Text = "Inactivo", Value = false } })"
                                    TextProperty="Text" ValueProperty="Value" class="form-control" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-8">
                    <label>Correos (separados por punto y coma ";")</label>
                    <RadzenTextArea @bind-Value="model.Correos" class="form-control" Rows="2" />
                </div>
                <div class="form-group col-md-4 d-flex align-items-end">
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Text="Guardar" Click="SaveObra" />
                    <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Primary" Text="Nuevo" Class="ml-2" Click="OnNew" />
                </div>
            </div>
        </RadzenFieldset>

        <RadzenDataGrid @ref="gridObras" TItem="DTOObras" Data="@listaDeObras" AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="10" class="mt-4">
            <Columns>
                <RadzenDataGridColumn TItem="DTOObras" Property="NombreCliente" Title="Cliente" Width="250px" />
                <RadzenDataGridColumn TItem="DTOObras" Property="Nombre" Title="Nombre de la Obra" />
                <RadzenDataGridColumn TItem="DTOObras" Property="Correos" Title="Correos" />
                <RadzenDataGridColumn TItem="DTOObras" Property="Activo" Title="Activo" Width="100px" TextAlign="TextAlign.Center">
                    <Template Context="data">
                        <RadzenCheckBox @bind-Value="data.Activo" Disabled="true" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTOObras" Title="Acciones" Width="120px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                    <Template Context="data">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => EditRow(data))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Class="ml-1" Click="@(async () => await DeleteRow(data))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private DTOObras model;
    private List<DTOObras> listaDeObras;
    private List<DTOLogisticMasterData> listaDeClientes;
    private RadzenDataGrid<DTOObras> gridObras;

    protected override async Task OnInitializedAsync()
    {
        OnNew();
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        listaDeObras = await logisticsService.GetAllObras();
        listaDeClientes = await logisticsService.GetCustomers();
    }

    private void OnNew()
    {
        this.model = new DTOObras { Activo = true };
    }

    private async Task SaveObra()
    {
        if (model.ClienteId == 0 || string.IsNullOrWhiteSpace(model.Nombre))
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", "Debe seleccionar un cliente y especificar un nombre para la obra.");
            return;
        }

        await logisticsService.CreateOrUpdateObra(model);
        notificationService.Notify(NotificationSeverity.Success, "Éxito", "Obra guardada correctamente.");

        OnNew();
        await LoadInitialData();
    }

    private void EditRow(DTOObras obra)
    {
        // Clonamos el objeto para asegurar que no se modifica la fila de la tabla directamente
        this.model = new DTOObras
        {
            Id = obra.Id,
            Nombre = obra.Nombre,
            ClienteId = obra.ClienteId,
            Correos = obra.Correos,
            Activo = obra.Activo,
            NombreCliente = obra.NombreCliente
        };
    }

    private async Task DeleteRow(DTOObras obra)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro? Esta acción desactivará la obra '{obra.Nombre}'."))
        {
            var result = await logisticsService.DeleteObra(obra.Id);
            if (result)
            {
                notificationService.Notify(NotificationSeverity.Success, "Éxito", "Obra desactivada.");
                await LoadInitialData();
            }
            else
            {
                notificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo desactivar la obra.");
            }
        }
    }
}